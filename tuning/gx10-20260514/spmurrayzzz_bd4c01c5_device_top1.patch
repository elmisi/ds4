+__global__ static void indexer_top1_kernel(uint32_t *selected, const float *scores, uint32_t n_comp, uint32_t n_tokens) {
+    uint32_t t = blockIdx.x;
+    uint32_t tid = threadIdx.x;
+    if (t >= n_tokens) return;
+    const float *row = scores + (uint64_t)t * n_comp;
+    float best_v = -INFINITY;
+    uint32_t best_i = UINT32_MAX;
+    for (uint32_t i = tid; i < n_comp; i += blockDim.x) {
+        const float v = row[i];
+        if (topk_score_better(v, i, best_v, best_i)) {
+            best_v = v;
+            best_i = i;
+        }
+    }
+    __shared__ float vals[1024];
+    __shared__ uint32_t idxs[1024];
+    vals[tid] = best_v;
+    idxs[tid] = best_i;
+    __syncthreads();
+    for (uint32_t stride = blockDim.x >> 1; stride > 0; stride >>= 1) {
+        if (tid < stride && topk_score_better(vals[tid + stride], idxs[tid + stride], vals[tid], idxs[tid])) {
+            vals[tid] = vals[tid + stride];
+            idxs[tid] = idxs[tid + stride];
+        }
+        __syncthreads();
+    }
+    if (tid == 0) selected[t] = idxs[0];
+}
