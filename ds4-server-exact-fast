#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")"

# Quality-preserving fast path for GB10:
# - full base model, no MTP
# - full K=6 routed experts
# - graph decode
# - exact Q8 SoA cache for attention output A/B
for name in ${!DS4_MTP_@}; do unset "$name"; done

unset DS4_MOE_ACTIVE_EXPERTS
unset DS4_MOE_ACTIVE_EXPERTS_RENORM
unset DS4_MOE_ACTIVE_EXPERTS_LAYERS
unset DS4_CUDA_MOE_ACTIVE_EXPERTS

unset DS4_CUDA_DIRECT_MODEL
unset DS4_CUDA_OUTPUT_TOP1
unset DS4_CUDA_FORCE_ORDERED_F16_MATMUL
unset DS4_CUDA_NO_ORDERED_F16_MATMUL

unset DS4_CUDA_Q8_CUBLAS_DECODE
unset DS4_CUDA_ATTENTION_OUTPUT_A_CUBLAS_MIN
unset DS4_CUDA_ATTENTION_OUTPUT_B_CUBLAS_MIN
unset DS4_CUDA_ATTN_Q_B_CUBLAS_DECODE
unset DS4_CUDA_Q8_F16_ALL
unset DS4_CUDA_Q8_F32_ALL
unset DS4_CUDA_Q8_F16_PRELOAD
unset DS4_CUDA_Q8_F32_PRELOAD

unset DS4_CUDA_Q8_SOA_BATCH2
unset DS4_CUDA_Q8_SOA_BATCH2_ATTN_OUTPUT_B
unset DS4_CUDA_Q8_SOA_QB
unset DS4_CUDA_Q8_SOA_QKV
unset DS4_CUDA_Q8_SOA_SHARED
unset DS4_CUDA_Q8_SOA_ALL
unset DS4_CUDA_Q8_SOA_CACHE_X

unset DS4_CUDA_MOE_DECODE_GATE_H16
unset DS4_CUDA_MOE_DECODE_GATE_NOAUX
unset DS4_CUDA_MOE_DECODE_GATE_PAIR2
unset DS4_CUDA_MOE_DECODE_FUSED_MIDQ
unset DS4_CUDA_MOE_DOWN_SUM6_PARALLEL
unset DS4_CUDA_MOE_DOWN_SUM6_ROW4
unset DS4_CUDA_MOE_K2_DIRECT_GATE

unset DS4_METAL_DECODE_STAGE_PROFILE
unset DS4_METAL_GRAPH_TOKEN_PROFILE
unset DS4_CUDA_MOE_PROFILE
unset DS4_CUDA_WEIGHT_CACHE_VERBOSE

export DS4_CUDA_GRAPH_DECODE=1
export DS4_CUDA_Q8_SOA_CACHE=1

if [ "$#" -eq 0 ]; then
    set -- --cuda \
        -m "${DS4_MODEL:-ds4flash.gguf}" \
        --ctx "${DS4_CTX:-256000}" \
        --host "${DS4_HOST:-0.0.0.0}" \
        --port "${DS4_PORT:-8000}" \
        --tokens "${DS4_TOKENS:-900}"
fi

exec ./ds4-server "$@"
